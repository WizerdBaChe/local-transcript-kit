# Repo-authored files are read by agents and Python on any platform: LF.
* text=auto eol=lf
# PowerShell 5.1 reads a script without a BOM as the ANSI code page; this one is ASCII-only, CRLF for Windows.
*.ps1 text eol=crlf
# reference-impl/ is a byte copy of the origin (docs/BUILD-SPEC.md section 9: byte-identical except declared
# edits); git must not convert anything there.
reference-impl/** -text
# the demo desk is the product's own record of a real run, kept byte-for-byte
docs/assets/demo/** -text
*.png binary
*.zip binary
